pre.voto, www.pre.voto {
	tls /etc/caddy/origin.crt /etc/caddy/origin.key
	encode gzip zstd

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	# Quiz share pages: when /{country}/quiz has a "top" query param,
	# rewrite to the backend share endpoint and proxy there.
	@quiz_share {
		path_regexp quizpath ^/([a-z]{2})/quiz$
		query top=*
	}
	handle @quiz_share {
		rewrite * /share{path}?{query}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}
}
