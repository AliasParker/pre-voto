import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Datos abiertos | pre.voto"
  description="API pública de datos abiertos de pre.voto: statements, candidatos y codificaciones bajo licencia CC-BY 4.0."
>
  <article class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-8">Datos abiertos</h1>

    <div class="prose">
      <p>
        Pre.voto publica todos sus datos editoriales — statements, candidatos y
        codificaciones de posiciones — bajo licencia
        <strong>Creative Commons CC-BY 4.0</strong>. Cualquier persona,
        organización, medio o universidad puede descargarlos, reproducirlos y
        construir sobre ellos con atribución.
      </p>

      <h2>API pública</h2>
      <p>
        Los datos están disponibles como JSON a través de tres endpoints REST.
        No requieren autenticación ni registro.
      </p>

      <div class="overflow-x-auto">
        <table>
          <thead>
            <tr>
              <th>Endpoint</th>
              <th>Descripción</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>/api/opendata/co/statements</code></td>
              <td>Las 20 afirmaciones del quiz con categoría, peso y orden</td>
            </tr>
            <tr>
              <td><code>/api/opendata/co/candidates</code></td>
              <td>Los 12 candidatos con partido, coalición, posicionamiento y % de cita directa</td>
            </tr>
            <tr>
              <td><code>/api/opendata/co/positions</code></td>
              <td>Las 240 codificaciones: posición, confianza, tipo de fuente, cita y URL</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3>Ejemplos</h3>
      <pre><code>curl https://pre.voto/api/opendata/co/statements
curl https://pre.voto/api/opendata/co/candidates
curl https://pre.voto/api/opendata/co/positions</code></pre>

      <p>
        Cada respuesta incluye los headers <code>X-License: CC-BY-4.0</code> y
        <code>Access-Control-Allow-Origin: *</code>.
      </p>

      <h2>Atribución</h2>
      <p>
        Si usas los datos, incluye la siguiente atribución en tu publicación o
        producto:
      </p>
      <blockquote>
        Equipo pre.voto, <a href="https://pre.voto">pre.voto</a>, CC-BY 4.0
      </blockquote>

      <h2>Licencia</h2>
      <p>
        Los datos editoriales están bajo
        <strong>CC-BY 4.0</strong>. El código fuente está bajo
        <strong>AGPL-3.0</strong>. Más detalles en
        <a href="/abierto">Código y datos abiertos</a>.
      </p>

      <h2>Freeze electoral</h2>
      <p>
        Durante los 7 días previos a una elección activa, los datos de
        codificación quedan congelados. La API sigue disponible, pero las
        codificaciones no se actualizan hasta después de la elección.
      </p>
    </div>

    <p class="text-sm text-ink-faint mt-8 italic">
      Última revisión: 23 de mayo de 2026.
    </p>
  </article>
</BaseLayout>
