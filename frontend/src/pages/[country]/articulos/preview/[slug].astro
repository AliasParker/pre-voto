import BaseLayout from "../../../../layouts/BaseLayout.astro";
import NewsletterSignup from "../../../../components/NewsletterSignup.astro";
import { fetchCountries, fetchArticlesPreview, fetchArticlePreview } from "../../../../lib/api";
import { getLocaleFromCountry, t } from "../../../../lib/i18n";
import { renderMarkdown } from "../../../../lib/markdown";
import type { CountryOut, ArticleDetail } from "../../../../lib/types";

export async function getStaticPaths() {
  const token = import.meta.env.ADMIN_PREVIEW_TOKEN;
  if (!token) return [];

  const countries = await fetchCountries();
  const paths = [];
  for (const country of countries) {
    try {
      const articles = await fetchArticlesPreview(country.code, token);
      for (const a of articles) {
        try {
          const detail = await fetchArticlePreview(country.code, a.slug, token);
          if (detail) {
            paths.push({
              params: { country: country.code, slug: a.slug },
              props: { country, article: detail },
            });
          }
        } catch {}
      }
    } catch {}
  }
  return paths;
}

interface Props {
  country: CountryOut;
  article: ArticleDetail;
}

const { country, article } = Astro.props;
const locale = getLocaleFromCountry(country.code);
const bodyHtml = renderMarkdown(article.body_markdown);
const dateStr = article.published_at
  ? new Date(article.published_at).toLocaleDateString(
      locale === "pt-BR" ? "pt-BR" : "es-CO",
      { year: "numeric", month: "long", day: "numeric" }
    )
  : null;
---

<BaseLayout
  title={`[Preview] ${article.title} | pre.voto`}
  description={article.dek || article.title}
  country={country.code}
  ogImage={article.hero_image_url || undefined}
>
  <meta slot="head" name="robots" content="noindex" />

  <article class="max-w-3xl mx-auto px-4 py-12">
    <!-- Preview banner -->
    <div class="bg-ocre/10 border border-ocre rounded-lg px-4 py-3 mb-6 text-sm text-ocre font-medium">
      {t(locale, "articles.previewBanner")}
    </div>

    <!-- Breadcrumb -->
    <nav class="text-sm text-ink-faint mb-6">
      <a href={`/${country.code}/articulos`} class="hover:text-brand transition-colors">
        &larr; {t(locale, "articles.backToArticles")}
      </a>
    </nav>

    <!-- Hero image -->
    {article.hero_image_url && (
      <img
        src={article.hero_image_url}
        alt=""
        loading="eager"
        decoding="async"
        class="w-full rounded-lg mb-6 max-h-96 object-cover"
      />
    )}
    {article.hero_image_attribution && (
      <p class="text-xs text-ink-faint -mt-4 mb-6">{article.hero_image_attribution}</p>
    )}

    <!-- Header -->
    <h1 class="font-serif text-3xl font-bold mb-2">{article.title}</h1>
    {article.dek && (
      <p class="font-serif italic text-xl text-ink-soft mb-4">{article.dek}</p>
    )}
    <div class="flex items-center gap-2 text-sm text-ink-faint mb-8">
      {article.author && dateStr && (
        <span>
          {t(locale, "articles.by", { author: article.author })} &middot; {t(locale, "articles.publishedOn", { date: dateStr })}
        </span>
      )}
      {article.author && !dateStr && (
        <span>{t(locale, "articles.by", { author: article.author })}</span>
      )}
      {!article.author && dateStr && (
        <span>{t(locale, "articles.publishedOn", { date: dateStr })}</span>
      )}
    </div>
    {article.tags && article.tags.length > 0 && (
      <div class="flex gap-1 mb-8 flex-wrap">
        {article.tags.map((tag) => (
          <span class="text-xs bg-paper-warm text-ink-faint px-2 py-0.5 rounded">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Body -->
    <div class="prose" set:html={bodyHtml} />

    <!-- Article footer -->
    <hr class="my-8 border-line" />
    <a
      href={`/${country.code}/articulos`}
      class="text-sm text-brand hover:underline"
    >
      &larr; {t(locale, "articles.backToArticles")}
    </a>

    <!-- Newsletter -->
    <div class="mt-12">
      <NewsletterSignup country={country.code} />
    </div>
  </article>
</BaseLayout>
