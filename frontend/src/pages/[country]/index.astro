import BaseLayout from "../../layouts/BaseLayout.astro";
import CountdownTimer from "../../components/islands/CountdownTimer.svelte";
import ArticleCard from "../../components/ArticleCard.astro";
import PollSummary from "../../components/PollSummary.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import {
  fetchCountries,
  fetchArticles,
  fetchPollAverage,
  fetchCandidates,
} from "../../lib/api";
import { getLocaleFromCountry, t } from "../../lib/i18n";
import { countries as countryMeta, getCountryName } from "../../lib/countries";
import type { CountryOut, ArticleOut, PollAverageOut, CandidateOut } from "../../lib/types";

export async function getStaticPaths() {
  const countries = await fetchCountries();
  const paths = [];
  for (const country of countries) {
    try {
      const articles = await fetchArticles(country.code, 0, 3);
      let pollAverage: PollAverageOut | null = null;
      let candidates: CandidateOut[] = [];
      try {
        pollAverage = await fetchPollAverage(country.code);
        candidates = await fetchCandidates(country.code);
      } catch {}
      paths.push({
        params: { country: country.code },
        props: { country, articles, pollAverage, candidates },
      });
    } catch {
      paths.push({
        params: { country: country.code },
        props: { country, articles: [], pollAverage: null, candidates: [] },
      });
    }
  }
  return paths;
}

interface Props {
  country: CountryOut;
  articles: ArticleOut[];
  pollAverage: PollAverageOut | null;
  candidates: CandidateOut[];
}

const { country, articles, pollAverage, candidates } = Astro.props;
const locale = getLocaleFromCountry(country.code);
const name = getCountryName(country.code, locale);
const meta = countryMeta[country.code];
const electionDate = country.next_election?.election_date;
const electionDesc = country.next_election?.description;
---

<BaseLayout
  title={`${name} | pre.voto`}
  description={electionDesc ? `${electionDesc} — Brújula electoral para ${name}` : `Brújula electoral para ${name}`}
  country={country.code}
>
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-4 py-12 md:py-20 text-center">
    <p class="text-4xl mb-2">{meta?.flag}</p>
    <h1 class="text-3xl md:text-5xl font-serif font-bold mb-4 max-w-3xl mx-auto leading-tight">
      {t(locale, `home.${country.code}.title`) !== `home.${country.code}.title`
        ? t(locale, `home.${country.code}.title`)
        : electionDesc || `${name} decide`}
    </h1>
    <p class="text-lg text-ink-soft max-w-2xl mx-auto leading-relaxed mb-6">
      {t(locale, `home.${country.code}.subtitle`) !== `home.${country.code}.subtitle`
        ? t(locale, `home.${country.code}.subtitle`)
        : ""}
    </p>
    {electionDate && (
      <div class="flex justify-center mb-6">
        <CountdownTimer
          client:visible
          targetDate={electionDate}
          locale={locale}
        />
      </div>
    )}
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        id="quiz-cta"
        href={`/${country.code}/quiz`}
        class="inline-block px-6 py-3 bg-brand text-white rounded-lg font-medium hover:bg-brand-dark transition-colors"
      >
        {t(locale, "country.startQuiz")}
      </a>
      <a
        href={`/${country.code}/candidatos`}
        class="inline-block px-6 py-3 border border-line rounded-lg text-ink-soft hover:text-ink hover:border-ink-faint transition-colors"
      >
        {t(locale, "country.viewCandidates")}
      </a>
    </div>
    <p class="text-sm text-ink-faint mt-4 max-w-md mx-auto">
      {t(locale, `home.${country.code}.microcopy`) !== `home.${country.code}.microcopy`
        ? t(locale, `home.${country.code}.microcopy`)
        : ""}
    </p>
    <p id="veda-notice" class="hidden text-sm text-ink-faint mt-3">
      {t(locale, "veda.quizDisabled")}
    </p>
  </section>

  <!-- Client-side veda check: disable quiz button during veda -->
  <script is:inline define:vars={{ countryCode: country.code }}>
    (async function checkVeda() {
      try {
        const res = await fetch(`/api/feature-flags/quiz-status?country=${countryCode}`);
        if (res.ok) {
          const data = await res.json();
          if (data.quiz_disabled) {
            const btn = document.getElementById("quiz-cta");
            const notice = document.getElementById("veda-notice");
            if (btn) {
              btn.href = `/${countryCode}/veda`;
              btn.classList.remove("bg-brand", "hover:bg-brand-dark");
              btn.classList.add("bg-ink-faint", "cursor-not-allowed");
            }
            if (notice) notice.classList.remove("hidden");
          }
        }
      } catch {}
    })();
  </script>

  <!-- How it works -->
  <section class="max-w-5xl mx-auto px-4 pb-12">
    <h2 class="text-xl font-bold mb-4">{t(locale, "howItWorks.title")}</h2>
    <div class="grid md:grid-cols-3 gap-4">
      <div class="border border-line rounded-lg p-6 bg-paper-warm/30">
        <h3 class="font-semibold mb-2">{t(locale, "howItWorks.card1Title")}</h3>
        <p class="text-sm text-ink-soft leading-relaxed">{t(locale, "howItWorks.card1Desc")}</p>
      </div>
      <div class="border border-line rounded-lg p-6 bg-paper-warm/30">
        <h3 class="font-semibold mb-2">{t(locale, "howItWorks.card2Title")}</h3>
        <p class="text-sm text-ink-soft leading-relaxed">{t(locale, "howItWorks.card2Desc")}</p>
      </div>
      <div class="border border-line rounded-lg p-6 bg-paper-warm/30">
        <h3 class="font-semibold mb-2">{t(locale, "howItWorks.card3Title")}</h3>
        <p class="text-sm text-ink-soft leading-relaxed">{t(locale, "howItWorks.card3Desc")}</p>
      </div>
    </div>
  </section>

  <!-- Latest articles -->
  <section class="max-w-5xl mx-auto px-4 pb-12">
    <h2 class="text-xl font-bold mb-4">{t(locale, "country.latestArticles")}</h2>
    {articles.length > 0 ? (
      <div class="grid md:grid-cols-3 gap-4">
        {articles.map((article) => (
          <ArticleCard article={article} country={country.code} />
        ))}
      </div>
    ) : (
      <p class="text-ink-faint text-sm">{t(locale, "country.noArticles")}</p>
    )}
  </section>

  <!-- Poll average -->
  {pollAverage && candidates.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 pb-12">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold">{t(locale, "country.pollSummary")}</h2>
        <a
          href={`/${country.code}/encuestas`}
          class="text-sm text-brand hover:text-brand-dark"
        >
          {t(locale, "country.viewPolls")}
        </a>
      </div>
      <div class="border border-line rounded-lg p-4">
        <PollSummary average={pollAverage} candidates={candidates} />
      </div>
    </section>
  )}

  <!-- Newsletter -->
  <section class="max-w-xl mx-auto px-4 pb-12">
    <NewsletterSignup country={country.code} />
  </section>
</BaseLayout>
