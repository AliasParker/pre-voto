---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CandidateCard from "../../../components/CandidateCard.astro";
import { fetchCountries, fetchCandidates } from "../../../lib/api";
import { getLocaleFromCountry, t } from "../../../lib/i18n";
import { getCountryName } from "../../../lib/countries";
import type { CountryOut, CandidateOut } from "../../../lib/types";

export async function getStaticPaths() {
  const countries = await fetchCountries();
  const paths = [];
  for (const country of countries) {
    try {
      const candidates = await fetchCandidates(country.code);
      paths.push({
        params: { country: country.code },
        props: { country, candidates },
      });
    } catch {
      paths.push({
        params: { country: country.code },
        props: { country, candidates: [] },
      });
    }
  }
  return paths;
}

interface Props {
  country: CountryOut;
  candidates: CandidateOut[];
}

const { country, candidates } = Astro.props;
const locale = getLocaleFromCountry(country.code);
const name = getCountryName(country.code, locale);
const electionDesc = country.next_election?.description;
---

<BaseLayout
  title={`${t(locale, "candidates.title")} — ${name} | pre.voto`}
  description={`${t(locale, "candidates.title")} ${electionDesc || name}`}
  country={country.code}
>
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">{t(locale, "candidates.title")}</h1>
    {electionDesc && (
      <p class="text-ink-soft mb-8">{electionDesc}</p>
    )}

    {candidates.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {candidates.map((candidate) => (
          <CandidateCard candidate={candidate} country={country.code} />
        ))}
      </div>
    ) : (
      <p class="text-ink-faint">{t(locale, "common.loading")}</p>
    )}

    <div class="mt-8 text-center">
      <a
        href={`/${country.code}/quiz`}
        class="inline-block px-6 py-3 bg-brand text-white rounded-lg font-medium hover:bg-brand-dark transition-colors"
      >
        {t(locale, "candidates.takeQuiz")}
      </a>
    </div>
  </section>
</BaseLayout>
