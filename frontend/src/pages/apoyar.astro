---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../lib/i18n";
import DonationForm from "../components/islands/DonationForm.svelte";
import { SHOW_DONATIONS } from "../lib/flags";

const locale = "es";

if (!SHOW_DONATIONS) {
  return Astro.redirect("/");
}
---

<BaseLayout
  title={`${t(locale, "donate.title")} | pre.voto`}
  description="pre.voto es un proyecto independiente que se financia con donaciones voluntarias. Contribuye para que sigamos llevando brújulas electorales a más países."
>
  <article class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-serif font-bold mb-6 text-center">
      {t(locale, "donate.title")}
    </h1>

    <div class="max-w-xl mx-auto mb-10 space-y-4 text-ink-soft leading-relaxed text-center">
      <p>{t(locale, "donate.intro")}</p>
      <p>{t(locale, "donate.body")}</p>
      <p>{t(locale, "donate.cta")}</p>
    </div>

    <section class="mb-12">
      <h2 class="text-xl font-serif font-bold mb-6 text-center">
        {t(locale, "donate.sectionTitle")}
      </h2>
      <DonationForm locale={locale} client:load />
    </section>

    <div class="prose mx-auto text-left max-w-xl">
      <h2 class="font-serif">{t(locale, "donate.howTitle")}</h2>
      <p>{t(locale, "donate.howBody")}</p>

      <h2 class="font-serif">{t(locale, "donate.transparencyTitle")}</h2>
      <p>{t(locale, "donate.transparencyBody")}</p>
    </div>

    <div class="mt-10 text-center text-sm text-ink-soft">
      <p>
        Para preguntas sobre donaciones, escribe a
        <a href="mailto:hola@pre.voto" class="text-terracotta hover:underline">
          hola@pre.voto</a
        >.
      </p>
    </div>
  </article>
</BaseLayout>
