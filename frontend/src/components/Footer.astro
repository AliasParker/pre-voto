---
import { getLocaleFromCountry, t } from "../lib/i18n";

interface Props {
  country?: string;
}

const { country } = Astro.props;
const locale = country ? getLocaleFromCountry(country) : "es";
---

<footer class="border-t border-line mt-12">
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-center gap-4 text-sm text-ink-soft">
        <a href="/metodologia" class="hover:text-ink">
          {t(locale, "nav.methodology")}
        </a>
        <a href="/sobre" class="hover:text-ink">
          {t(locale, "nav.about")}
        </a>
        <a href="/privacidad" class="hover:text-ink">
          {t(locale, "nav.privacy")}
        </a>
        <a
          href="https://github.com/AliasParker/pre-voto"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-ink"
        >
          GitHub
        </a>
      </div>
      <div class="text-sm text-ink-faint">
        <p>{t(locale, "footer.license")}</p>
      </div>
    </div>
  </div>
</footer>
