---
import { getLocaleFromCountry, t, type Locale } from "../lib/i18n";
import { SHOW_DONATIONS } from "../lib/flags";

interface Props {
  country?: string;
}

const { country } = Astro.props;
const locale: Locale = country ? getLocaleFromCountry(country) : "es";

// Pages that should show the Ley 2494 disclaimer
const pathname = Astro.url.pathname;
const showLey2494 = country && (
  pathname.includes("/quiz") ||
  pathname.includes("/candidatos") ||
  pathname.includes("/articulos") ||
  pathname.includes("/encuestas") ||
  pathname.includes("/veda")
);
---

<footer class="border-t border-line mt-12 bg-paper-warm">
  <div class="max-w-5xl mx-auto px-4 py-10">
    <!-- Main footer content -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Brand + description -->
      <div>
        <a href="/" class="text-lg font-bold tracking-tight inline-block mb-2">
          pre<span class="text-brand">.</span>voto
        </a>
        <p class="text-sm text-ink-soft leading-relaxed">
          {t(locale, "footer.description")}
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="font-semibold text-sm mb-3 font-sans">{t(locale, "footer.navTitle")}</h4>
        <nav class="flex flex-col gap-2 text-sm text-ink-soft">
          {country && (
            <a href={`/${country}/quiz`} class="hover:text-ink transition-colors">
              {locale === "pt-BR" ? "Bússola" : "Brújula"}
            </a>
          )}
          {country && (
            <a href={`/${country}/candidatos`} class="hover:text-ink transition-colors">
              {t(locale, "candidates.title")}
            </a>
          )}
          <a href="/metodologia" class="hover:text-ink transition-colors">
            {t(locale, "nav.methodology")}
          </a>
          <a href="/sobre" class="hover:text-ink transition-colors">
            {t(locale, "nav.about")}
          </a>
          <a href="/privacidad" class="hover:text-ink transition-colors">
            {t(locale, "nav.privacy")}
          </a>
          {SHOW_DONATIONS && (
            <a href="/apoyar" class="hover:text-ink transition-colors">
              {t(locale, "footer.support")}
            </a>
          )}
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-semibold text-sm mb-3 font-sans">{t(locale, "footer.contactTitle")}</h4>
        <div class="flex flex-col gap-2 text-sm text-ink-soft">
          <a href="mailto:hola@pre.voto" class="hover:text-ink transition-colors">
            hola@pre.voto
          </a>
          <a href="mailto:errores@pre.voto" class="hover:text-ink transition-colors">
            errores@pre.voto
          </a>
          <a
            href="https://x.com/prevotoLATAM"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-ink transition-colors"
          >
            @prevotoLATAM
          </a>
          <a href="/abierto" class="hover:text-ink transition-colors">
            Código y datos abiertos
          </a>
        </div>
      </div>
    </div>

    <!-- Independence statement -->
    <div class="border-t border-line pt-6 mb-4">
      <p class="text-xs text-ink-faint leading-relaxed max-w-3xl">
        {t(locale, "footer.independence")}
      </p>
    </div>

    <!-- Ley 2494 disclaimer (quiz/results/candidatos/articulos pages) -->
    {showLey2494 && (
      <div class="mb-4">
        <p class="text-xs text-ink-faint leading-relaxed max-w-3xl">
          {t(locale, "footer.ley2494")}
        </p>
      </div>
    )}

    <!-- License -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-xs text-ink-faint">
      <p>{t(locale, "footer.license")}</p>
      <p>© {new Date().getFullYear()} pre.voto</p>
    </div>
  </div>
</footer>
