# =============================================================================
# pre.voto — Production Environment Variables
# Copy to /opt/prevoto/.env and fill in real values before deploying.
# =============================================================================

# App environment: must be "production" on the VPS
ENV=production

# ---- PostgreSQL ----
POSTGRES_USER=prevoto
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL
POSTGRES_DB=prevoto
# Must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql+asyncpg://prevoto:CHANGE_ME_GENERATE_WITH_OPENSSL@postgres:5432/prevoto

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Admin ----
# Generate: openssl rand -base64 32
ADMIN_API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# ---- Beehiiv (newsletter) ----
# Leave empty to disable newsletter integration
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ---- Cloudflare R2 (backups) ----
# Create an R2 API token at: Cloudflare Dashboard > R2 > Manage R2 API Tokens
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
# Format: https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=prevoto-backups

# ---- Wikimedia Commons (candidate photos) ----
WIKIMEDIA_USER_AGENT=pre.voto-bot/1.0 (https://pre.voto; contact@pre.voto)

# ---- Sentry (optional, leave blank to disable) ----
SENTRY_DSN=

# ---- Public URLs (HTTPS in production) ----
PUBLIC_API_URL=https://pre.voto
PUBLIC_SITE_URL=https://pre.voto

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_SUBSCRIBE_PER_HOUR=5

# ---- Electoral veda (per country, enable as needed) ----
VEDA_ENABLED_CO=false
VEDA_START_CO=
VEDA_END_CO=

# ---- SMTP (production — Gmail via Cloudflare) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=hola@pre.voto
SMTP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
SMTP_SENDER=hola@pre.voto
SMTP_USE_TLS=true
