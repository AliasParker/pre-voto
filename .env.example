# ============================================================
# pre.voto — Environment Variables
# Copy to .env and fill in real values before running.
# ============================================================

# App environment: development | production
ENV=development

# ---- PostgreSQL ----
POSTGRES_USER=prevoto
POSTGRES_PASSWORD=changeme-use-openssl-rand
POSTGRES_DB=prevoto
DATABASE_URL=postgresql+asyncpg://prevoto:changeme-use-openssl-rand@postgres:5432/prevoto

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Admin ----
ADMIN_API_KEY=changeme-use-openssl-rand-base64-32

# ---- Beehiiv (newsletter) ----
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ---- S3-compatible Object Storage (backups) ----
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=my-app-backups

# ---- Wikimedia Commons (candidate photos) ----
WIKIMEDIA_USER_AGENT=pre.voto-bot/1.0 (https://pre.voto; contact@pre.voto)

# ---- Sentry (optional, leave blank to disable) ----
SENTRY_DSN=

# ---- Public URLs ----
PUBLIC_API_URL=http://localhost
PUBLIC_SITE_URL=http://localhost

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_SUBSCRIBE_PER_HOUR=5

# ---- Electoral veda (per country) ----
VEDA_ENABLED_CO=false
VEDA_START_CO=
VEDA_END_CO=

# ---- Usage tracking ----
SESSION_HASH_SALT=changeme-use-openssl-rand-base64-32
ADMIN_USER=admin
ADMIN_PASS=changeme-use-openssl-rand-base64-32

# ---- SMTP (Mailpit in dev) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
