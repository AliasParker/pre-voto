:80 {
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	# Quiz share pages: when /{country}/quiz has a "top" query param,
	# rewrite to the backend share endpoint and proxy there.
	# Without "top", the request falls through to the frontend.
	@quiz_share {
		path_regexp quizpath ^/([a-z]{2})/quiz$
		query top=*
	}
	handle @quiz_share {
		rewrite * /share{path}?{query}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
